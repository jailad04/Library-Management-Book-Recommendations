# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Specify your MongoDB URI (local or MongoDB Atlas connection string)
# If left blank or set to 'memory', an in-memory MongoDB instance will be used for zero-config evaluation.
MONGODB_URI=mongodb://localhost:27017/booknest

# Authentication Secrets
JWT_SECRET=your_jwt_secret_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Microservices
FASTAPI_RECOMMENDATION_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
