# BookNest Environment Configuration Example
# Express Backend API URL (default: http://localhost:5000/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Enable mock API fallback during frontend development and portfolio showcase
# When true, API calls will seamlessly use realistic mock datasets if the backend is offline
VITE_USE_MOCK_FALLBACK=true

# Application environment
VITE_APP_ENV=development
